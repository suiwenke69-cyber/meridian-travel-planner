{
  "name": "meridian-sea-travel-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Map-first Southeast Asia travel planner for travellers departing from Singapore.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "build:static": "node scripts/build-static.mjs",
    "deploy:pages": "node scripts/build-static.mjs && node scripts/publish-pages.mjs",
    "serve:public": "./scripts/serve-public.sh",
    "postinstall": "node scripts/vendor-maplibre-worker.mjs",
    "predev": "node scripts/vendor-maplibre-worker.mjs",
    "prebuild": "node scripts/vendor-maplibre-worker.mjs",
    "images:resolve": "node scripts/fetch-bali-images.mjs",
    "images:download": "node scripts/fetch-bali-images.mjs --download"
  },
  "dependencies": {
    "maplibre-gl": "^6.12.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
