# ---------------------------------------------------------------------------
# Meridian — Southeast Asia Travel Planner
# Copy to `.env.local` and fill in what you have. Everything is OPTIONAL:
# the app runs with zero configuration using open basemaps.
# Never commit `.env.local` or any real secret.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# BASEMAP — nothing to configure.
#
# The map uses MapLibre GL with a style authored in components/map/basemap-style.ts
# over two free, keyless vector tile hosts:
#
#   primary   CARTO vector tiles   (carto.streets)
#   fallback  OpenFreeMap          (planet)
#
# There is no API key, no account and no cost, and OpenFreeMap is switched to
# automatically if CARTO's tiles start failing. Commercial providers could be
# added as further entries in components/map/basemap-style.ts, which is why the
# variables below are reserved rather than required.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STADIA_KEY=

# --- Routing -----------------------------------------------------------------
# Between every pair of itinerary stops the app asks a routing engine for a real
# road distance and duration. If none answers, the leg is shown as
# "Route unavailable" — the app never substitutes a straight-line estimate for a
# drive time.
#
# DEFAULT: OSRM. Free, keyless, CORS-enabled, so it works with no backend.
NEXT_PUBLIC_ROUTING_PROVIDER=osrm
NEXT_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
# Set to `none` to disable routing entirely (legs then render as unavailable).
# NEXT_PUBLIC_ROUTING_PROVIDER=none

# --- Optional keyed routing providers ----------------------------------------
# These are SERVER-ONLY. Keys are read in app/api/route/route.ts and never reach
# the browser. Configure one and it is preferred over OSRM automatically.
#
# ROUTING_PROVIDER=openrouteservice   # or mapbox | google
OPENROUTESERVICE_API_KEY=
MAPBOX_DIRECTIONS_TOKEN=
GOOGLE_ROUTES_API_KEY=

# --- Guide extraction (导入攻略) ----------------------------------------------
# Extraction sits behind `lib/research/extractor.ts`. TWO providers ship:
#
#   deterministic (DEFAULT) — rule-based, runs in the browser, no key, no cost.
#   llm                     — calls /api/extract, which is where a key lives.
#
# The static GitHub Pages build has no server, so this route is not deployed and
# the deterministic extractor runs. Set these only where a Node server exists.
#
# The client-side selector is safe to expose: it names a provider, it carries no
# secret. The keys below are SERVER-ONLY and are read in
# app/api/extract/route.ts and nowhere else.
NEXT_PUBLIC_GUIDE_EXTRACTOR=deterministic
GUIDE_EXTRACTOR=deterministic
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. deepseek-chat / gpt-4o-mini.
GUIDE_EXTRACTOR_MODEL=

# --- Analytics (unused in V1) -----------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
